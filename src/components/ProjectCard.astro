---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---
<article class="project-card">
  <div class="project-meta">
    <span class="project-status"><span aria-hidden="true"></span>{project.status}</span>
    <span class="tags" aria-label="Technologies">
      {project.tags.map((tag) => <span class="tag">#{tag}</span>)}
    </span>
  </div>
  <div class="project-summary">
    <h3><a href={project.url} rel="noreferrer">{project.name}</a></h3>
    <p>{project.description}</p>
    <div class="project-actions">
      <a href={project.url} rel="noreferrer">Open project <span aria-hidden="true">↗</span></a>
      {project.sourceUrl && (
        <a href={project.sourceUrl} rel="noreferrer">Source <span aria-hidden="true">↗</span></a>
      )}
    </div>
  </div>
</article>
