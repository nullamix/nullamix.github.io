---
import { formatPostDate } from '../utils/formatPostDate';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      language: 'en' | 'fa';
    };
  };
}

const { post } = Astro.props;
const locale = post.data.language === 'fa' ? 'fa-IR' : 'en';
const date = formatPostDate(post.data.pubDate, locale, 'short');
---
<article class="post-card">
  <div class="post-meta">
    <time
      datetime={post.data.pubDate.toISOString()}
      lang={post.data.language}
      dir={post.data.language === 'fa' ? 'rtl' : 'ltr'}
    >{date}</time>
    <span class="tags" aria-label="Tags">
      {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
    </span>
  </div>
  <div class="post-summary" lang={post.data.language} dir="auto">
    <h3><a href={`/notes/${post.id}/`}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
  </div>
  <span class="post-arrow" aria-hidden="true">→</span>
</article>
