---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog" description="DevOps blog posts about Linux, containers, CI/CD, registry operations, security, and observability.">
  <section class="article-header">
    <span class="eyebrow">Blog</span>
    <h1>Notes on infrastructure work.</h1>
    <p class="lead">Practical posts about things that fail, leak, timeout, misroute, or silently become technical debt.</p>
  </section>

  <section class="post-list" aria-label="Blog posts">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
