---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title="DevOps notes by AmirHossein"
  description="Practical DevOps writing by AmirHossein: Linux, containers, CI/CD, security, monitoring, and production engineering."
>
  <section class="hero">
    <p class="command" aria-label="Terminal command">
      <span>amir@nullamix</span>:~$ cat ./field-notes
    </p>
    <h1>Infrastructure notes from the sharp edges.</h1>
    <p class="lead">
      Practical writing on Linux, containers, delivery pipelines, observability, and the
      trade-offs that show up in production.
    </p>
    <div class="actions">
      <a href="/blog/">Browse all notes <span aria-hidden="true">→</span></a>
      <a href="https://github.com/nullamix" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section scope" aria-labelledby="scope-title">
    <div class="section-heading">
      <span class="section-index">01</span>
      <h2 id="scope-title">Working set</h2>
    </div>
    <dl class="scope-list">
      <div>
        <dt>delivery</dt>
        <dd>CI/CD, automation, release design</dd>
      </div>
      <div>
        <dt>runtime</dt>
        <dd>Linux, containers, networking</dd>
      </div>
      <div>
        <dt>reliability</dt>
        <dd>Observability, incidents, security</dd>
      </div>
    </dl>
  </section>

  <section class="section" aria-labelledby="latest-title">
    <div class="section-heading">
      <span class="section-index">02</span>
      <h2 id="latest-title">Latest notes</h2>
      <a class="section-link" href="/blog/">View archive <span aria-hidden="true">→</span></a>
    </div>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
