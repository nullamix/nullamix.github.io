---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  language?: 'en' | 'fa';
  keywords?: string[];
}

import '../styles/global.css';
import InfrastructureScene from '../components/InfrastructureScene.astro';

const siteName = 'nullamix';
const siteUrl = Astro.site ?? new URL('https://nullamix.ir');
const defaultDescription =
  'nullamix is AmirHossein\'s DevOps blog about Docker, Linux, containers, CI/CD, security, observability, and production engineering.';
const defaultKeywords = [
  'nullamix',
  'devops',
  'دواپس',
  'docker',
  'داکر',
  'linux',
  'containers',
  'ci/cd',
  'production engineering',
  'AmirHossein'
];
const {
  title = siteName,
  description = defaultDescription,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  publishedTime,
  updatedTime,
  language = 'en',
  keywords = defaultKeywords
} = Astro.props;
const pageTitle =
  title === siteName
    ? `${siteName} · DevOps, Docker and Linux notes`
    : `${title} · ${siteName}`;
const canonical = new URL(canonicalPath, siteUrl).toString();
const path = Astro.url.pathname;
const isContentPage =
  path.startsWith('/notes/') ||
  path.startsWith('/tags/') ||
  path.startsWith('/projects/');
const keywordContent = keywords.join(', ');
const personId = new URL('/#amirhossein', siteUrl).toString();
const websiteId = new URL('/#website', siteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'AmirHossein',
      alternateName: 'nullamix',
      url: new URL('/', siteUrl).toString(),
      sameAs: [
        'https://github.com/nullamix',
        'https://t.me/FUNCtastic'
      ],
      knowsAbout: [
        'DevOps',
        'دواپس',
        'Docker',
        'Linux',
        'Containers',
        'CI/CD',
        'Security',
        'Observability'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: siteName,
      alternateName: 'nullamix DevOps blog',
      url: new URL('/', siteUrl).toString(),
      description: defaultDescription,
      inLanguage: ['en', 'fa-IR'],
      publisher: { '@id': personId }
    },
    type === 'article'
      ? {
          '@type': 'BlogPosting',
          headline: title,
          description,
          url: canonical,
          datePublished: publishedTime?.toISOString(),
          dateModified: (updatedTime ?? publishedTime)?.toISOString(),
          inLanguage: language === 'fa' ? 'fa-IR' : 'en',
          keywords: keywordContent,
          mainEntityOfPage: canonical,
          isPartOf: { '@id': websiteId },
          author: { '@id': personId },
          publisher: { '@id': personId }
        }
      : {
          '@type': 'WebPage',
          name: pageTitle,
          description,
          url: canonical,
          inLanguage: language === 'fa' ? 'fa-IR' : 'en',
          keywords: keywordContent,
          isPartOf: { '@id': websiteId },
          about: { '@id': personId }
        }
  ]
};
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="author" content="AmirHossein (nullamix)" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0d0f0e" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; upgrade-insecure-requests"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="nullamix RSS" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={language === 'fa' ? 'fa_IR' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (() => {
        const isHome = window.location.pathname === '/';
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let hasSeenIntro = false;

        try {
          hasSeenIntro = sessionStorage.getItem('nullamix:intro:v1') === 'seen';
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }

        if (isHome && !reducedMotion && !hasSeenIntro) {
          document.documentElement.classList.add('show-intro');
          try {
            sessionStorage.setItem('nullamix:intro:v1', 'seen');
          } catch {
            // The intro can still run without persisting session state.
          }
        }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class={isContentPage ? 'content-page' : undefined}>
    <InfrastructureScene />

    {path === '/' && (
      <button
        class="scene-focus-toggle"
        type="button"
        aria-pressed="false"
        data-scene-focus-toggle
      >
        <span class="scene-focus-indicator" aria-hidden="true"></span>
        <span data-scene-focus-label>animation only</span>
      </button>
    )}

    {path === '/' && (
      <div class="boot-screen" data-intro aria-hidden="true">
        <div class="boot-inner">
          <div class="boot-header">
            <span>pipeline / nullamix</span>
            <span class="boot-run">run #042</span>
          </div>

          <div class="pipeline" aria-hidden="true">
            <div class="pipeline-track"><span></span></div>
            <div class="pipeline-step pipeline-build">
              <span class="pipeline-node">01</span>
              <strong>build</strong>
              <small>image</small>
            </div>
            <div class="pipeline-step pipeline-verify">
              <span class="pipeline-node">02</span>
              <strong>verify</strong>
              <small>policy</small>
            </div>
            <div class="pipeline-step pipeline-ship">
              <span class="pipeline-node">03</span>
              <strong>ship</strong>
              <small>notes</small>
            </div>
          </div>

          <div class="boot-log">
            <p class="boot-log-line line-one"><span>→</span> resolving infrastructure context</p>
            <p class="boot-log-line line-two"><span>✓</span> checks passed</p>
            <p class="boot-log-line line-three"><span>✓</span> deployment ready</p>
          </div>

          <div class="boot-footer">
            <span class="boot-mark">N</span>
            <span>infrastructure notes</span>
            <button type="button" data-intro-skip tabindex="-1">skip</button>
          </div>
        </div>
      </div>
    )}

    <div class="site-shell">
      <a class="skip-link" href="#content">Skip to content</a>
      <header class="site-header">
        <nav class="nav" aria-label="Main navigation">
          <a class="brand" href="/" aria-label="nullamix home">
            <img src="/favicon.svg" width="28" height="28" alt="" />
            <span>nullamix</span>
          </a>
          <div class="nav-links">
            <a href="/notes/" aria-current={path.startsWith('/notes/') ? 'page' : undefined}>Notes</a>
            <a href="/projects/" aria-current={path.startsWith('/projects/') ? 'page' : undefined}>Projects</a>
            <a href="https://t.me/FUNCtastic" rel="me noreferrer">Telegram <span aria-hidden="true">↗</span></a>
            <a href="https://github.com/nullamix" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </nav>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer class="footer">
        <p><span class="status-dot" aria-hidden="true"></span> status: documenting</p>
        <p><a href="/rss.xml">RSS</a> · Field notes by AmirHossein.</p>
      </footer>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const intro = document.querySelector('[data-intro]');

        if (!intro || !root.classList.contains('show-intro')) return;

        const skip = intro.querySelector('[data-intro-skip]');
        let timeout;

        const finish = () => {
          window.clearTimeout(timeout);
          root.classList.remove('show-intro');
          root.classList.add('intro-complete');
          window.removeEventListener('keydown', onKeydown);
          window.setTimeout(() => intro.remove(), 500);
        };

        const onKeydown = (event) => {
          if (event.key === 'Escape') finish();
        };

        skip?.addEventListener('click', finish, { once: true });
        window.addEventListener('keydown', onKeydown);
        timeout = window.setTimeout(finish, 3200);
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('[data-scene-focus-toggle]');
        const label = toggle?.querySelector('[data-scene-focus-label]');

        if (!(toggle instanceof HTMLButtonElement) || !label) return;

        const setFocusMode = (enabled) => {
          root.classList.toggle('scene-focus', enabled);
          toggle.setAttribute('aria-pressed', String(enabled));
          label.textContent = enabled ? 'Show content' : 'Topology only';
        };

        toggle.addEventListener('click', () => {
          setFocusMode(!root.classList.contains('scene-focus'));
        });

        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && root.classList.contains('scene-focus')) {
            setFocusMode(false);
            toggle.focus();
          }
        });
      })();
    </script>
  </body>
</html>
